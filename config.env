# meetrec settings. An environment variable with the same name overrides the value here,
# e.g.  MEETREC_LANG=auto meetrec transcribe

# Where recordings go (one folder per meeting)
: "${MEETREC_DIR:=$HOME/Recordings/meetings}"

# --- voice-catcher (recording) ---
: "${MEETREC_BR_MIX:=64k}"      # meeting.opus bitrate
: "${MEETREC_BR_OTHERS:=48k}"   # others.opus bitrate
: "${MEETREC_BR_ME:=32k}"       # me.opus bitrate

# --- transcriber ---
: "${MEETREC_AUTO_TRANSCRIBE:=1}"       # 1 = transcribe in the background after every stop
: "${MEETREC_ENGINES:=11 local}"        # which engines to run, in order: 11 (ElevenLabs) and/or local
: "${MEETREC_LANG:=en}"                 # en | bn | auto | any language code (both engines)

# local engine (faster-whisper)  → transcript_local.*
: "${MEETREC_MODEL:=large-v3}"          # large-v3 (best, ~1× real-time) | large-v3-turbo (~3.7×, less accurate)
: "${MEETREC_THREADS:=0}"               # CPU threads; 0 = automatic
: "${MEETREC_LOCAL_VOCAB:=1}"           # 1 = feed transcriber/vocab.txt to Whisper as hotwords
: "${MEETREC_LOCAL_MULTILINGUAL:=0}"   # 1 = per-window language detection (didn't help for short Bengali bits)

# ElevenLabs engine  → transcript_11.*   (API key lives in .env.local, never here)
: "${MEETREC_11_MODEL:=scribe_v3}"      # scribe_v3 | scribe_v2
: "${MEETREC_11_SECONDARY_LANGS:=}"     # e.g. "bn" for a meeting with Bengali mixed in (usually not needed)

export MEETREC_DIR MEETREC_ENGINES MEETREC_LANG MEETREC_MODEL MEETREC_THREADS MEETREC_LOCAL_VOCAB MEETREC_LOCAL_MULTILINGUAL \
       MEETREC_11_MODEL MEETREC_11_SECONDARY_LANGS
